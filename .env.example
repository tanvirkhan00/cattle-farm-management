# Smart Cattle Farm – Environment Configuration
# Copy this file to .env and configure your Firebase credentials

# ==============================================================================
# Firebase Cloud Configuration (Firestore, Authentication, Storage)
# ==============================================================================
# The application runs immediately in resilient Local Persistence Mode if left blank.
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-cattle-farm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-cattle-farm
VITE_FIREBASE_STORAGE_BUCKET=your-cattle-farm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ==============================================================================
# Application Defaults
# ==============================================================================
VITE_DEFAULT_LANGUAGE=bn
VITE_FARM_LOCATION=Gazipur
