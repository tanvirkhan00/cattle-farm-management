# Smart Cattle Farm – Environment Configuration
# Copy this file to .env and configure your credentials

# Supabase PostgreSQL Configuration (Optional for Cloud Sync)
# The application runs immediately in Local Persistent Mode if left blank.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Farm Defaults
VITE_DEFAULT_LANGUAGE=bn
VITE_FARM_LOCATION=Gazipur
